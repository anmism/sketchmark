{
  "version": 1,
  "canvas": {
    "width": 1280,
    "height": 720,
    "background": "#f8fafc",
    "duration": 4,
    "fps": 30
  },
  "elements": [
    {
      "id": "browser_box",
      "type": "rect",
      "x": 120,
      "y": 160,
      "width": 180,
      "height": 80,
      "radius": 12,
      "fill": "#ffffff",
      "stroke": "#2563eb",
      "strokeWidth": 2
    },
    {
      "id": "browser_label",
      "type": "text",
      "text": "Browser",
      "x": 210,
      "y": 200,
      "align": "center",
      "valign": "middle",
      "fontSize": 18,
      "fill": "#111827"
    },
    {
      "id": "resolver_box",
      "type": "rect",
      "x": 380,
      "y": 160,
      "width": 180,
      "height": 80,
      "radius": 12,
      "fill": "#ffffff",
      "stroke": "#2563eb",
      "strokeWidth": 2
    },
    {
      "id": "resolver_label",
      "type": "text",
      "text": "DNS Resolver",
      "x": 470,
      "y": 200,
      "align": "center",
      "valign": "middle",
      "fontSize": 18,
      "fill": "#111827"
    },
    {
      "id": "query_arrow",
      "type": "arrow",
      "from": "browser_box.right",
      "to": "resolver_box.left",
      "stroke": "#2563eb",
      "strokeWidth": 3
    },
    {
      "id": "packet",
      "type": "circle",
      "radius": 8,
      "fill": "#ef4444",
      "follow": "query_arrow",
      "progress": {
        "from": 0,
        "to": 1,
        "delay": 0.5,
        "duration": 2,
        "ease": "ease-in-out"
      }
    },
    {
      "id": "title",
      "type": "text",
      "text": "DNS Query",
      "x": 340,
      "y": 90,
      "align": "center",
      "valign": "middle",
      "fontSize": 32,
      "weight": 800,
      "fill": "#0f172a"
    }
  ]
}
