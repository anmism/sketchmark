{
  "version": 1,
  "canvas": {
    "width": 960,
    "height": 540,
    "background": "#f8fafc"
  },
  "scenes": {
    "slide": {
      "elements": [
        {
          "id": "title",
          "type": "text",
          "text": "Deck mode",
          "x": 80,
          "y": 72,
          "align": "left",
          "valign": "middle",
          "fontSize": 44,
          "weight": 850,
          "fill": "#0f172a"
        },
        {
          "id": "subtitle",
          "type": "text",
          "text": "Base slide plus explicit reveal steps",
          "x": 80,
          "y": 122,
          "align": "left",
          "valign": "middle",
          "fontSize": 22,
          "fill": "#64748b"
        },
        {
          "id": "one_box",
          "type": "rect",
          "x": 90,
          "y": 210,
          "width": 220,
          "height": 105,
          "radius": 14,
          "fill": "#dbeafe",
          "stroke": "#2563eb",
          "strokeWidth": 3
        },
        {
          "id": "one_text",
          "type": "text",
          "text": "1. Primitives",
          "x": 200,
          "y": 262,
          "align": "center",
          "valign": "middle",
          "fontSize": 22,
          "weight": 800,
          "fill": "#1e3a8a"
        },
        {
          "id": "two_box",
          "type": "rect",
          "x": 370,
          "y": 210,
          "width": 220,
          "height": 105,
          "radius": 14,
          "fill": "#dcfce7",
          "stroke": "#16a34a",
          "strokeWidth": 3,
          "opacity": 0
        },
        {
          "id": "two_text",
          "type": "text",
          "text": "2. Validate",
          "x": 480,
          "y": 262,
          "align": "center",
          "valign": "middle",
          "fontSize": 22,
          "weight": 800,
          "fill": "#166534",
          "opacity": 0
        },
        {
          "id": "three_box",
          "type": "rect",
          "x": 650,
          "y": 210,
          "width": 220,
          "height": 105,
          "radius": 14,
          "fill": "#fef3c7",
          "stroke": "#f59e0b",
          "strokeWidth": 3,
          "opacity": 0
        },
        {
          "id": "three_text",
          "type": "text",
          "text": "3. Export",
          "x": 760,
          "y": 262,
          "align": "center",
          "valign": "middle",
          "fontSize": 22,
          "weight": 800,
          "fill": "#92400e",
          "opacity": 0
        },
        {
          "id": "arrow_a",
          "type": "arrow",
          "from": "one_box.right",
          "to": "two_box.left",
          "stroke": "#64748b",
          "strokeWidth": 3,
          "opacity": 0
        },
        {
          "id": "arrow_b",
          "type": "arrow",
          "from": "two_box.right",
          "to": "three_box.left",
          "stroke": "#64748b",
          "strokeWidth": 3,
          "opacity": 0
        }
      ],
      "steps": [
        {
          "id": "show_validation",
          "show": [
            "two_box",
            "two_text",
            "arrow_a"
          ],
          "duration": 0.5
        },
        {
          "id": "show_export",
          "show": [
            "three_box",
            "three_text",
            "arrow_b"
          ],
          "duration": 0.5
        },
        {
          "id": "hide_subtitle",
          "hide": [
            "subtitle"
          ],
          "duration": 0.5
        }
      ]
    }
  }
}