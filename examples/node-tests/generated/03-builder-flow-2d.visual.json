{
  "version": 1,
  "canvas": {
    "width": 960,
    "height": 540,
    "background": "#f8fafc",
    "duration": 4,
    "fps": 30
  },
  "elements": [
    {
      "id": "title",
      "type": "text",
      "text": "Builder helpers expand to primitives",
      "x": 480,
      "y": 60,
      "align": "center",
      "valign": "middle",
      "fontSize": 32,
      "weight": 800,
      "fill": "#111827"
    },
    {
      "type": "rect",
      "id": "browser_box",
      "x": 110,
      "y": 170,
      "width": 170,
      "height": 80,
      "radius": 12,
      "fill": "#ffffff",
      "stroke": "#2563eb",
      "strokeWidth": 2
    },
    {
      "type": "text",
      "id": "browser_label",
      "text": "Browser",
      "x": 195,
      "y": 210,
      "align": "center",
      "valign": "middle",
      "fontSize": 18,
      "fill": "#111827"
    },
    {
      "type": "rect",
      "id": "resolver_box",
      "x": 390,
      "y": 170,
      "width": 170,
      "height": 80,
      "radius": 12,
      "fill": "#ffffff",
      "stroke": "#16a34a",
      "strokeWidth": 2
    },
    {
      "type": "text",
      "id": "resolver_label",
      "text": "Resolver",
      "x": 475,
      "y": 210,
      "align": "center",
      "valign": "middle",
      "fontSize": 18,
      "fill": "#111827"
    },
    {
      "type": "rect",
      "id": "server_box",
      "x": 670,
      "y": 170,
      "width": 170,
      "height": 80,
      "radius": 12,
      "fill": "#ffffff",
      "stroke": "#f59e0b",
      "strokeWidth": 2
    },
    {
      "type": "text",
      "id": "server_label",
      "text": "Server",
      "x": 755,
      "y": 210,
      "align": "center",
      "valign": "middle",
      "fontSize": 18,
      "fill": "#111827"
    },
    {
      "type": "arrow",
      "id": "query",
      "from": "browser_box.right",
      "to": "resolver_box.left",
      "stroke": "#2563eb",
      "strokeWidth": 4
    },
    {
      "type": "text",
      "id": "query_label",
      "text": "query",
      "x": 335,
      "y": 150,
      "align": "center",
      "valign": "middle",
      "fontSize": 14,
      "fill": "#2563eb"
    },
    {
      "type": "arrow",
      "id": "lookup",
      "from": "resolver_box.right",
      "to": "server_box.left",
      "stroke": "#16a34a",
      "strokeWidth": 4
    },
    {
      "type": "text",
      "id": "lookup_label",
      "text": "lookup",
      "x": 615,
      "y": 150,
      "align": "center",
      "valign": "middle",
      "fontSize": 14,
      "fill": "#16a34a"
    },
    {
      "type": "circle",
      "id": "query_packet",
      "radius": 7,
      "fill": "#ef4444",
      "follow": "query",
      "progress": {
        "from": 0,
        "to": 1,
        "duration": 1.6,
        "delay": 0.2,
        "ease": "ease-in-out"
      }
    },
    {
      "type": "circle",
      "id": "lookup_packet",
      "radius": 7,
      "fill": "#f59e0b",
      "follow": "lookup",
      "progress": {
        "from": 0,
        "to": 1,
        "duration": 1.6,
        "delay": 1.8,
        "ease": "ease-in-out"
      }
    },
    {
      "type": "rect",
      "id": "tip_box",
      "x": 360,
      "y": 330,
      "width": 240,
      "height": 64,
      "radius": 8,
      "fill": "#111827",
      "stroke": "#ef4444"
    },
    {
      "type": "text",
      "id": "tip_text",
      "text": "No compound JSON is emitted",
      "x": 480,
      "y": 362,
      "align": "center",
      "valign": "middle",
      "fontSize": 15,
      "fill": "#ffffff"
    },
    {
      "type": "arrow",
      "id": "tip_arrow",
      "from": "tip_box.bottom",
      "to": "resolver_box.bottom",
      "stroke": "#ef4444",
      "strokeWidth": 2
    }
  ]
}