      "stroke": "none"
    },
    {
      "id": "bullet-text-4",
      "type": "text",
      "x": 98,
      "y": 770,
      "text": "The output frame contains fully resolved properties with no remaining references.",
      "align": "left",
      "valign": "top",
      "fontSize": 14,
      "fontFamily": "Inter, system-ui, sans-serif",
      "weight": 400,
