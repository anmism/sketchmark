    {
      "id": "bullet-text-0",
      "type": "text",
      "x": 98,
      "y": 650,
      "text": "Documents must declare version: 1 and a canvas with width and height.",
      "align": "left",
      "valign": "top",
      "fontSize": 14,
      "fontFamily": "Inter, system-ui, sans-serif",
      "weight": 400,
      "fill": "#1a1a2e",
      "maxWidth": 1102
    },
    {
      "id": "bullet-dot-1",
      "type": "path",
      "d": "M 84 687 A 3 3 0 1 1 84 687.01 Z",
      "fill": "#2563eb",
      "stroke": "none"
    },
    {
      "id": "bullet-text-1",
      "type": "text",
      "x": 98,
      "y": 680,
      "text": "Elements are flat arrays of path, text, image, point, or group primitives.",
      "align": "left",
      "valign": "top",
      "fontSize": 14,
      "fontFamily": "Inter, system-ui, sans-serif",
      "weight": 400,
      "fill": "#1a1a2e",
      "maxWidth": 1102
    },
    {
      "id": "bullet-dot-2",
      "type": "path",
      "d": "M 84 717 A 3 3 0 1 1 84 717.01 Z",
      "fill": "#2563eb",
      "stroke": "none"
    },
    {
      "id": "bullet-text-2",
      "type": "text",
      "x": 98,
      "y": 710,
      "text": "Timelines are element-local — each element owns its own tracks and keyframes.",
      "align": "left",
      "valign": "top",
      "fontSize": 14,
      "fontFamily": "Inter, system-ui, sans-serif",
      "weight": 400,
      "fill": "#1a1a2e",
      "maxWidth": 1102
    },
    {
      "id": "bullet-dot-3",
      "type": "path",
      "d": "M 84 747 A 3 3 0 1 1 84 747.01 Z",
      "fill": "#2563eb",
      "stroke": "none"
    },
    {
      "id": "bullet-text-3",
      "type": "text",
      "x": 98,
      "y": 740,
      "text": "Interpolation resolves per-track using cubic bezier, graph, or hold curves.",
      "align": "left",
      "valign": "top",
      "fontSize": 14,
      "fontFamily": "Inter, system-ui, sans-serif",
      "weight": 400,
      "fill": "#1a1a2e",
      "maxWidth": 1102
    },
    {
      "id": "bullet-dot-4",
