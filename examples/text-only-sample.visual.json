{
  "version": 1,
  "canvas": {
    "width": 1280,
    "height": 720,
    "background": "#0f172a",
    "duration": 8,
    "fps": 30
  },
  "elements": [
    {
      "id": "title",
      "type": "text",
      "x": 640,
      "y": 54,
      "text": "Text Only Animation Sample",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 46,
      "weight": 800,
      "fill": "#f8fafc"
    },
    {
      "id": "subtitle",
      "type": "text",
      "x": 640,
      "y": 128,
      "text": "No paths, no images, no groups",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 18,
      "fill": "#93c5fd"
    },
    {
      "id": "charset",
      "type": "text",
      "x": 640,
      "y": 178,
      "text": "The quick brown fox jumps over 13 lazy dogs.",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 24,
      "fill": "#e2e8f0"
    },
    {
      "id": "symbols",
      "type": "text",
      "x": 640,
      "y": 208,
      "text": "0123456789 ! ? @ # $ % ^ & * ( ) [ ] { } + - = / : ; , .",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 18,
      "fill": "#cbd5e1"
    },
    {
      "id": "status",
      "type": "text",
      "x": 640,
      "y": 252,
      "text": "Draft",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 52,
      "weight": 800,
      "fill": "#facc15",
      "timeline": {
        "tracks": {
          "text": {
            "keyframes": [
              [
                0,
                "Draft"
              ],
              [
                2,
                "Design"
              ],
              [
                4,
                "Animate"
              ],
              [
                6,
                "Export"
              ],
              [
                8,
                "Done"
              ]
            ]
          }
        }
      }
    },
    {
      "id": "ticker",
      "type": "text",
      "x": 80,
      "y": 320,
      "text": "This line moves left to right using a position track.",
      "align": "left",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 24,
      "fill": "#f8fafc",
      "timeline": {
        "tracks": {
          "position": {
            "keyframes": [
              [
                0,
                [
                  80,
                  320
                ]
              ],
              [
                8,
                [
                  840,
                  320
                ]
              ]
            ]
          }
        }
      }
    },
    {
      "id": "fill_cycle",
      "type": "text",
      "x": 640,
      "y": 378,
      "text": "Fill color animation",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 32,
      "weight": 700,
      "fill": "#22d3ee",
      "timeline": {
        "tracks": {
          "fill": {
            "keyframes": [
              [
                0,
                "#22d3ee"
              ],
              [
                2,
                "#a78bfa"
              ],
              [
                4,
                "#f97316"
              ],
              [
                6,
                "#22c55e"
              ],
              [
                8,
                "#22d3ee"
              ]
            ]
          }
        }
      }
    },
    {
      "id": "weight_cycle",
      "type": "text",
      "x": 640,
      "y": 426,
      "text": "Weight: 300 -> 400 -> 700 -> 400",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 28,
      "weight": 300,
      "fill": "#e2e8f0",
      "timeline": {
        "tracks": {
          "weight": {
            "keyframes": [
              [
                0,
                300
              ],
              [
                2,
                400
              ],
              [
                4,
                700
              ],
              [
                6,
                400
              ],
              [
                8,
                300
              ]
            ]
          }
        }
      }
    },
    {
      "id": "size_spacing",
      "type": "text",
      "x": 640,
      "y": 474,
      "text": "Font size + letter spacing",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 30,
      "letterSpacing": 0,
      "fill": "#bfdbfe",
      "timeline": {
        "tracks": {
          "fontSize": {
            "keyframes": [
              [
                0,
                30
              ],
              [
                4,
                46
              ],
              [
                8,
                30
              ]
            ]
          },
          "letterSpacing": {
            "keyframes": [
              [
                0,
                0
              ],
              [
                4,
                4
              ],
              [
                8,
                0
              ]
            ]
          }
        }
      }
    },
    {
      "id": "font_stack_switch",
      "type": "text",
      "x": 640,
      "y": 522,
      "text": "Font stack track: Roboto -> Arial -> Roboto",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 24,
      "weight": 700,
      "fill": "#f1f5f9",
      "timeline": {
        "tracks": {
          "fontFamily": {
            "keyframes": [
              [
                0,
                "Roboto, Arial, sans-serif"
              ],
              [
                4,
                "Arial, Helvetica, sans-serif"
              ],
              [
                8,
                "Roboto, Arial, sans-serif"
              ]
            ]
          }
        }
      }
    },
    {
      "id": "paragraph",
      "type": "text",
      "x": 640,
      "y": 590,
      "text": "This paragraph is text only and animates lineHeight and opacity. It helps compare editor, SVG, PNG, and MP4 output consistency.",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 20,
      "lineHeight": 1.2,
      "maxWidth": 960,
      "wrap": true,
      "fill": "#cbd5e1",
      "timeline": {
        "tracks": {
          "lineHeight": {
            "keyframes": [
              [
                0,
                1.1
              ],
              [
                4,
                1.8
              ],
              [
                8,
                1.1
              ]
            ]
          },
          "opacity": {
            "keyframes": [
              [
                0,
                0.7
              ],
              [
                2,
                1
              ],
              [
                6,
                1
              ],
              [
                8,
                0.7
              ]
            ]
          }
        }
      }
    },
    {
      "id": "spin_origin",
      "type": "text",
      "x": 640,
      "y": 680,
      "text": "Origin + rotation test",
      "align": "center",
      "fontFamily": "Roboto, Arial, sans-serif",
      "fontSize": 22,
      "weight": 700,
      "origin": [
        640,
        680
      ],
      "fill": "#facc15",
      "timeline": {
        "tracks": {
          "rotation": {
            "keyframes": [
              [
                0,
                0
              ],
              [
                8,
                360
              ]
            ]
          }
        }
      }
    }
  ]
}
