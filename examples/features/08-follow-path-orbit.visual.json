{
  "version": 1,
  "canvas": {
    "width": 800,
    "height": 440,
    "background": "#ffffff",
    "duration": 5,
    "fps": 30
  },
  "elements": [
    {
      "id": "title",
      "type": "text",
      "text": "Path Follow",
      "x": 400,
      "y": 45,
      "align": "center",
      "valign": "middle",
      "fontSize": 30,
      "weight": 800,
      "fill": "#111827"
    },
    {
      "id": "route",
      "type": "path",
      "d": "M 120 300 C 200 80 330 370 430 180 S 650 150 690 310",
      "fill": "none",
      "stroke": "#2563eb",
      "strokeWidth": 5
    },
    {
      "id": "tracker",
      "type": "circle",
      "radius": 12,
      "fill": "#f59e0b",
      "stroke": "#92400e",
      "strokeWidth": 2,
      "follow": "route",
      "progress": {
        "from": 0,
        "to": 1,
        "duration": 4,
        "delay": 0.4,
        "ease": "ease-in-out"
      }
    },
    {
      "id": "note",
      "type": "text",
      "text": "A circle can follow a path using an explicit progress animation.",
      "x": 400,
      "y": 380,
      "align": "center",
      "valign": "middle",
      "fontSize": 17,
      "fill": "#475569",
      "maxWidth": 620
    }
  ]
}
