{
  "version": 1,
  "canvas": {
    "width": 1280,
    "height": 720,
    "background": "#f8fafc",
    "duration": 10,
    "fps": 30
  },
  "scenes": {
    "intro_2d": {
      "elements": [
        {
          "id": "intro_title",
          "type": "text",
          "text": "From Sketch to 3D Insight",
          "x": 640,
          "y": 150,
          "align": "center",
          "valign": "middle",
          "fontSize": 52,
          "weight": 800,
          "fill": "#0f172a",
          "opacity": 1,
          "animate": {
            "opacity": { "from": 0, "to": 1, "duration": 0.7, "ease": "ease-out" },
            "y": { "from": 185, "to": 150, "duration": 0.7, "ease": "ease-out" }
          }
        },
        {
          "id": "idea_card",
          "type": "rect",
          "x": 430,
          "y": 260,
          "width": 420,
          "height": 130,
          "radius": 20,
          "fill": "#dbeafe",
          "stroke": "#2563eb",
          "strokeWidth": 3,
          "animate": {
            "width": { "from": 80, "to": 420, "duration": 1.2, "delay": 0.45, "ease": "ease-in-out" }
          }
        },
        {
          "id": "idea_text",
          "type": "text",
          "text": "Start with a clear 2D explanation",
          "x": 640,
          "y": 325,
          "align": "center",
          "valign": "middle",
          "fontSize": 26,
          "weight": 700,
          "fill": "#1e40af",
          "maxWidth": 360,
          "opacity": 1,
          "animate": {
            "opacity": { "from": 0, "to": 1, "duration": 0.6, "delay": 1.0 }
          }
        },
        {
          "id": "intro_footer",
          "type": "text",
          "text": "0-2s: animated 2D primitives",
          "x": 640,
          "y": 610,
          "align": "center",
          "valign": "middle",
          "fontSize": 18,
          "fill": "#64748b"
        }
      ]
    },
    "product_3d": {
      "canvas": {
        "space": "3d",
        "renderer": "three",
        "background": "#eef2ff"
      },
      "elements": [
        {
          "id": "floor",
          "type": "plane",
          "position": [0, -1.05, 0],
          "size": [7, 5],
          "fill": "#dbeafe",
          "stroke": "#bfdbfe"
        },
        {
          "id": "base",
          "type": "cuboid",
          "position": [0, -0.35, 0],
          "size": [3.3, 0.35, 2.2],
          "fill": "#334155"
        },
        {
          "id": "screen",
          "type": "cuboid",
          "position": [0, 0.8, -0.35],
          "size": [2.8, 1.7, 0.18],
          "fill": "#2563eb",
          "rotationY": -10,
          "animate": {
            "rotationY": { "from": -10, "to": 10, "duration": 2, "ease": "ease-in-out" }
          }
        },
        {
          "id": "screen_glow",
          "type": "sphere",
          "position": [0.75, 1.0, -0.48],
          "radius": 0.16,
          "fill": "#facc15",
          "scale": 1,
          "animate": {
            "positionY": { "from": 0.85, "to": 1.2, "duration": 2, "ease": "ease-in-out" },
            "scale": { "from": 0.7, "to": 1.25, "duration": 2, "ease": "ease-in-out" }
          }
        },
        {
          "id": "stand",
          "type": "cuboid",
          "position": [0, 0.05, 0.28],
          "size": [0.35, 0.9, 0.35],
          "fill": "#64748b"
        },
        {
          "id": "product_label",
          "type": "text3d",
          "text": "2-4s: structured 3D product",
          "position": [0, 2.25, 0],
          "fontSize": 0.32,
          "fill": "#111827"
        },
        {
          "id": "ambient",
          "type": "light",
          "kind": "ambient",
          "intensity": 0.55
        },
        {
          "id": "key",
          "type": "light",
          "kind": "directional",
          "position": [5, 8, 5],
          "intensity": 1.25
        }
      ]
    },
    "flow_2d": {
      "elements": [
        {
          "id": "flow_title",
          "type": "text",
          "text": "Then show the process",
          "x": 640,
          "y": 90,
          "align": "center",
          "valign": "middle",
          "fontSize": 42,
          "weight": 800,
          "fill": "#0f172a"
        },
        {
          "id": "input_box",
          "type": "rect",
          "x": 160,
          "y": 280,
          "width": 190,
          "height": 90,
          "radius": 16,
          "fill": "#ffffff",
          "stroke": "#2563eb",
          "strokeWidth": 3
        },
        {
          "id": "input_label",
          "type": "text",
          "text": "Input",
          "x": 255,
          "y": 325,
          "align": "center",
          "valign": "middle",
          "fontSize": 24,
          "weight": 700,
          "fill": "#111827"
        },
        {
          "id": "engine_box",
          "type": "rect",
          "x": 545,
          "y": 280,
          "width": 190,
          "height": 90,
          "radius": 16,
          "fill": "#ffffff",
          "stroke": "#16a34a",
          "strokeWidth": 3
        },
        {
          "id": "engine_label",
          "type": "text",
          "text": "Engine",
          "x": 640,
          "y": 325,
          "align": "center",
          "valign": "middle",
          "fontSize": 24,
          "weight": 700,
          "fill": "#111827"
        },
        {
          "id": "output_box",
          "type": "rect",
          "x": 930,
          "y": 280,
          "width": 190,
          "height": 90,
          "radius": 16,
          "fill": "#ffffff",
          "stroke": "#f59e0b",
          "strokeWidth": 3
        },
        {
          "id": "output_label",
          "type": "text",
          "text": "Output",
          "x": 1025,
          "y": 325,
          "align": "center",
          "valign": "middle",
          "fontSize": 24,
          "weight": 700,
          "fill": "#111827"
        },
        {
          "id": "flow_a",
          "type": "arrow",
          "from": "input_box.right",
          "to": "engine_box.left",
          "stroke": "#2563eb",
          "strokeWidth": 4
        },
        {
          "id": "flow_b",
          "type": "arrow",
          "from": "engine_box.right",
          "to": "output_box.left",
          "stroke": "#16a34a",
          "strokeWidth": 4
        },
        {
          "id": "packet_a",
          "type": "circle",
          "radius": 11,
          "fill": "#ef4444",
          "follow": "flow_a",
          "progress": { "from": 0, "to": 1, "duration": 1.0, "delay": 0.2, "ease": "ease-in-out" }
        },
        {
          "id": "packet_b",
          "type": "circle",
          "radius": 11,
          "fill": "#f59e0b",
          "follow": "flow_b",
          "progress": { "from": 0, "to": 1, "duration": 1.0, "delay": 1.0, "ease": "ease-in-out" }
        },
        {
          "id": "flow_footer",
          "type": "text",
          "text": "4-6s: 2D packet animation",
          "x": 640,
          "y": 610,
          "align": "center",
          "valign": "middle",
          "fontSize": 18,
          "fill": "#64748b"
        }
      ]
    },
    "chart_3d": {
      "canvas": {
        "space": "3d",
        "renderer": "three",
        "background": "#f8fafc"
      },
      "elements": [
        {
          "id": "chart_floor",
          "type": "plane",
          "position": [0, -1, 0],
          "size": [7, 4],
          "fill": "#e2e8f0"
        },
        {
          "id": "bar_low",
          "type": "cuboid",
          "position": [-2, -0.1, 0],
          "size": [0.72, 1.8, 0.72],
          "fill": "#93c5fd",
          "scaleY": 1,
          "animate": {
            "scaleY": { "from": 0.25, "to": 1, "duration": 0.8, "delay": 0.1, "ease": "ease-out" }
          }
        },
        {
          "id": "bar_mid",
          "type": "cuboid",
          "position": [0, 0.35, 0],
          "size": [0.72, 2.7, 0.72],
          "fill": "#3b82f6",
          "scaleY": 1,
          "animate": {
            "scaleY": { "from": 0.25, "to": 1, "duration": 0.9, "delay": 0.35, "ease": "ease-out" }
          }
        },
        {
          "id": "bar_high",
          "type": "cuboid",
          "position": [2, 0.85, 0],
          "size": [0.72, 3.7, 0.72],
          "fill": "#1d4ed8",
          "scaleY": 1,
          "rotationY": -8,
          "animate": {
            "scaleY": { "from": 0.25, "to": 1, "duration": 1, "delay": 0.6, "ease": "ease-out" },
            "rotationY": { "from": -8, "to": 8, "duration": 2, "ease": "ease-in-out" }
          }
        },
        {
          "id": "chart_label",
          "type": "text3d",
          "text": "6-8s: structured 3D chart",
          "position": [0, 2.55, 0],
          "fontSize": 0.34,
          "fill": "#111827"
        },
        {
          "id": "chart_light",
          "type": "light",
          "kind": "directional",
          "position": [5, 8, 5],
          "intensity": 1.2
        }
      ]
    },
    "summary_2d": {
      "elements": [
        {
          "id": "summary_title",
          "type": "text",
          "text": "End with a clear takeaway",
          "x": 640,
          "y": 150,
          "align": "center",
          "valign": "middle",
          "fontSize": 48,
          "weight": 800,
          "fill": "#16a34a",
          "opacity": 1,
          "animate": {
            "opacity": { "from": 0, "to": 1, "duration": 0.5 },
            "y": { "from": 185, "to": 150, "duration": 0.7, "ease": "ease-out" }
          }
        },
        {
          "id": "summary_path",
          "type": "path",
          "d": "M 350 340 C 450 250 550 430 640 330 S 820 260 920 340",
          "fill": "none",
          "stroke": "#16a34a",
          "strokeWidth": 6
        },
        {
          "id": "summary_dot",
          "type": "circle",
          "radius": 14,
          "fill": "#f59e0b",
          "stroke": "#92400e",
          "strokeWidth": 2,
          "follow": "summary_path",
          "progress": { "from": 0, "to": 1, "duration": 1.6, "delay": 0.25, "ease": "ease-in-out" }
        },
        {
          "id": "summary_text",
          "type": "text",
          "text": "8-10s: final 2D path-follow animation",
          "x": 640,
          "y": 610,
          "align": "center",
          "valign": "middle",
          "fontSize": 18,
          "fill": "#64748b"
        }
      ]
    }
  },
  "sequences": {
    "main": {
      "id": "main",
      "clips": [
        { "scene": "intro_2d", "duration": 2 },
        { "scene": "product_3d", "duration": 2 },
        { "scene": "flow_2d", "duration": 2 },
        { "scene": "chart_3d", "duration": 2 },
        { "scene": "summary_2d", "duration": 2 }
      ],
      "export": {
        "format": "mp4",
        "fps": 30
      }
    }
  }
}
