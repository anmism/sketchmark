{
  "version": 1,
  "canvas": {
    "width": 900,
    "height": 520,
    "background": "#f8fafc"
  },
  "elements": [
    {
      "id": "device",
      "type": "rect",
      "x": 300,
      "y": 170,
      "width": 300,
      "height": 190,
      "radius": 22,
      "fill": "#111827"
    },
    {
      "id": "screen",
      "type": "rect",
      "x": 330,
      "y": 205,
      "width": 240,
      "height": 110,
      "radius": 12,
      "fill": "#1d4ed8"
    },
    {
      "id": "button",
      "type": "circle",
      "cx": 450,
      "cy": 338,
      "radius": 10,
      "fill": "#e5e7eb"
    },
    {
      "id": "callout_box",
      "type": "rect",
      "x": 625,
      "y": 92,
      "width": 190,
      "height": 70,
      "radius": 10,
      "fill": "#ffffff",
      "stroke": "#ef4444",
      "strokeWidth": 3
    },
    {
      "id": "callout_text",
      "type": "text",
      "text": "High contrast display",
      "x": 720,
      "y": 127,
      "align": "center",
      "valign": "middle",
      "fontSize": 16,
      "weight": 700,
      "fill": "#111827",
      "maxWidth": 160
    },
    {
      "id": "callout_arrow",
      "type": "arrow",
      "from": "callout_box.left",
      "to": "screen.top-right",
      "stroke": "#ef4444",
      "strokeWidth": 3
    }
  ]
}
