{
  "version": 1,
  "canvas": {
    "width": 720,
    "height": 420,
    "background": "#ffffff"
  },
  "elements": [
    {
      "id": "title",
      "type": "text",
      "text": "One Coordinate Model",
      "x": 360,
      "y": 42,
      "align": "center",
      "valign": "middle",
      "fontSize": 28,
      "weight": 800,
      "fill": "#111827"
    },
    {
      "id": "box",
      "type": "rect",
      "x": 110,
      "y": 120,
      "width": 180,
      "height": 100,
      "radius": 10,
      "fill": "#eff6ff",
      "stroke": "#2563eb",
      "strokeWidth": 3
    },
    {
      "id": "box_label",
      "type": "text",
      "text": "box: x/y is top-left",
      "x": 200,
      "y": 170,
      "align": "center",
      "valign": "middle",
      "fontSize": 16,
      "fill": "#1e40af"
    },
    {
      "id": "box_origin",
      "type": "circle",
      "cx": 110,
      "cy": 120,
      "radius": 6,
      "fill": "#ef4444"
    },
    {
      "id": "circle",
      "type": "circle",
      "cx": 510,
      "cy": 170,
      "radius": 55,
      "fill": "#f0fdf4",
      "stroke": "#16a34a",
      "strokeWidth": 3
    },
    {
      "id": "circle_label",
      "type": "text",
      "text": "circle: cx/cy is center",
      "x": 510,
      "y": 170,
      "align": "center",
      "valign": "middle",
      "fontSize": 16,
      "fill": "#166534"
    },
    {
      "id": "line",
      "type": "arrow",
      "from": [200, 280],
      "to": [510, 280],
      "stroke": "#334155",
      "strokeWidth": 3
    },
    {
      "id": "line_label",
      "type": "text",
      "text": "line/arrow: from/to endpoints",
      "x": 355,
      "y": 310,
      "align": "center",
      "valign": "middle",
      "fontSize": 16,
      "fill": "#334155"
    }
  ]
}
