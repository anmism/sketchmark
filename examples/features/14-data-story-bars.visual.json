{
  "version": 1,
  "canvas": {
    "width": 900,
    "height": 520,
    "background": "#ffffff",
    "duration": 4,
    "fps": 30
  },
  "elements": [
    {
      "id": "title",
      "type": "text",
      "text": "Revenue by Quarter",
      "x": 450,
      "y": 52,
      "align": "center",
      "valign": "middle",
      "fontSize": 32,
      "weight": 800,
      "fill": "#111827"
    },
    {
      "id": "axis_x",
      "type": "line",
      "from": [140, 410],
      "to": [800, 410],
      "stroke": "#94a3b8",
      "strokeWidth": 2
    },
    {
      "id": "axis_y",
      "type": "line",
      "from": [140, 410],
      "to": [140, 120],
      "stroke": "#94a3b8",
      "strokeWidth": 2
    },
    {
      "id": "bar_q1",
      "type": "rect",
      "x": 200,
      "y": 280,
      "width": 90,
      "height": 130,
      "fill": "#bfdbfe",
      "animate": {
        "height": {"from": 0, "to": 130, "duration": 1, "delay": 0.3},
        "y": {"from": 410, "to": 280, "duration": 1, "delay": 0.3}
      }
    },
    {
      "id": "bar_q2",
      "type": "rect",
      "x": 340,
      "y": 230,
      "width": 90,
      "height": 180,
      "fill": "#93c5fd",
      "animate": {
        "height": {"from": 0, "to": 180, "duration": 1, "delay": 0.6},
        "y": {"from": 410, "to": 230, "duration": 1, "delay": 0.6}
      }
    },
    {
      "id": "bar_q3",
      "type": "rect",
      "x": 480,
      "y": 185,
      "width": 90,
      "height": 225,
      "fill": "#60a5fa",
      "animate": {
        "height": {"from": 0, "to": 225, "duration": 1, "delay": 0.9},
        "y": {"from": 410, "to": 185, "duration": 1, "delay": 0.9}
      }
    },
    {
      "id": "bar_q4",
      "type": "rect",
      "x": 620,
      "y": 145,
      "width": 90,
      "height": 265,
      "fill": "#2563eb",
      "animate": {
        "height": {"from": 0, "to": 265, "duration": 1, "delay": 1.2},
        "y": {"from": 410, "to": 145, "duration": 1, "delay": 1.2}
      }
    },
    {
      "id": "labels",
      "type": "text",
      "text": "Q1          Q2          Q3          Q4",
      "x": 455,
      "y": 448,
      "align": "center",
      "valign": "middle",
      "fontSize": 16,
      "fill": "#475569"
