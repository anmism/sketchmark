  "sequences": {
    "mixed": {
      "id": "mixed",
      "clips": [
        {"scene": "intro_2d", "duration": 2},
        {"scene": "model_3d", "duration": 3},
        {"scene": "summary_2d", "duration": 2}
      ],
      "export": {
        "format": "mp4",
        "fps": 30
      }
    }
