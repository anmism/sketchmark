{
  "version": 1,
  "canvas": {
    "width": 960,
    "height": 540,
    "background": "#f8fafc",
    "duration": 7,
    "fps": 30
  },
  "scenes": {
    "intro_2d": {
      "elements": [
        {
          "id": "intro_title",
          "type": "text",
          "text": "2D setup",
          "x": 480,
          "y": 180,
          "align": "center",
          "valign": "middle",
          "fontSize": 48,
          "weight": 800,
          "fill": "#111827"
        },
        {
          "id": "intro_card",
          "type": "rect",
          "x": 310,
          "y": 250,
          "width": 340,
          "height": 96,
          "radius": 18,
          "fill": "#dbeafe",
          "stroke": "#2563eb",
          "strokeWidth": 3
        },
        {
          "id": "intro_caption",
          "type": "text",
          "text": "The same sequence can switch renderer surfaces.",
          "x": 480,
          "y": 298,
          "align": "center",
          "valign": "middle",
          "fontSize": 18,
          "fill": "#1e40af",
          "maxWidth": 300
        }
      ]
    },
    "model_3d": {
      "canvas": {
        "space": "3d",
        "renderer": "three",
        "background": "#eef2ff"
      },
      "elements": [
        {
          "id": "floor",
          "type": "plane",
          "position": [0, -1, 0],
          "size": [6, 5],
          "fill": "#e2e8f0"
        },
        {
          "id": "body",
          "type": "cuboid",
          "position": [0, 0, 0],
          "size": [2.4, 1.2, 1.4],
          "fill": "#2563eb"
        },
        {
          "id": "core",
          "type": "sphere",
          "position": [0, 1.05, 0],
          "radius": 0.42,
          "fill": "#f59e0b"
        },
        {
          "id": "label",
          "type": "text3d",
          "text": "3D model",
          "position": [0, 2.05, 0],
          "fontSize": 0.42,
          "fill": "#111827"
        },
        {
          "id": "light",
          "type": "light",
          "kind": "directional",
          "position": [5, 8, 5],
          "intensity": 1.2
        }
      ]
    },
    "summary_2d": {
      "elements": [
        {
          "id": "summary_title",
          "type": "text",
          "text": "Back to 2D",
          "x": 480,
          "y": 190,
          "align": "center",
          "valign": "middle",
          "fontSize": 48,
          "weight": 800,
          "fill": "#16a34a"
        },
        {
          "id": "summary_arrow",
          "type": "arrow",
          "from": [300, 300],
          "to": [660, 300],
          "stroke": "#16a34a",
          "strokeWidth": 5
        },
        {
          "id": "summary_label",
          "type": "text",
          "text": "Renderer layers are reused instead of destroyed.",
          "x": 480,
          "y": 355,
          "align": "center",
          "valign": "middle",
          "fontSize": 20,
          "fill": "#334155",
          "maxWidth": 560
        }
      ]
